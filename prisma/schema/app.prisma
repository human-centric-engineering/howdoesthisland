// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

/// An invitation into a workspace for someone who already has an account
/// (t-9). The invitee sees it in the app and accepts or declines it; accepting
/// adds them through core's `addMember()`. A person with no account is invited
/// by core's sign-up invitation instead, from the same form.
///
/// One row per person per workspace: re-inviting someone who declined, let it
/// expire, or left resets the row to PENDING, so no partial unique index is
/// needed (B13). `userId` and `invitedByUserId` are plain strings with
/// hand-written FKs in the migration, so `User` (core) is not edited.
model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  orgId           String?
  org             Org?                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The invitee. FK → user, ON DELETE CASCADE (an invitation is theirs).
  userId          String
  role            OrgRole                   @default(MEMBER)
  status          WorkspaceInvitationStatus @default(PENDING)
  /// Who sent it. FK → user, ON DELETE SET NULL (the workspace keeps the record).
  invitedByUserId String?
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([orgId, userId])
  @@index([userId, status])
  @@index([orgId])
  @@map("app_workspace_invitation")
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Frameworks (t-10, f-framework-store) ────────────────────────────────────
//
// A framework's records, versioned. Design: .context/app/planning/app-plan.md
// §8.1. All four are shared config (no orgId; `globalConfig` in
// lib/app/tenancy-classification.ts), written only by lib/app/frameworks/store
// through the import and publish scripts. A published version never changes:
// the store refuses every write that would touch one.

/// A framework the service can judge against (D2), e.g. `howdoesthisland`.
model Framework {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String
  summary   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  versions  FrameworkVersion[]
  projects  Project[]

  @@map("app_framework")
}

/// One version of a framework, imported from a reviewed JSON file.
model FrameworkVersion {
  id              String                 @id @default(cuid())
  frameworkId     String
  framework       Framework              @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  /// Semver, from the file's `meta.version`.
  version         String
  /// The file's own schema version (`meta.schema_version`).
  schemaVersion   String
  status          FrameworkVersionStatus @default(DRAFT)
  /// The imported file as parsed, kept for export and audit.
  sourceDocument  Json
  /// sha256 of the imported file's bytes.
  sourceSha256    String
  publishedAt     DateTime?
  /// The calibration run that allowed publishing, copied at publish (t-37):
  /// `{ runId, ranAt, agreement, setVersion, checks, judgeModels }`. Null on a draft, and on 0.5.1,
  /// published before the gate existed.
  calibration     Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  nodes           FrameworkNode[]
  links           FrameworkLink[]
  assessments     Assessment[]
  calibrationRuns CalibrationRun[]

  @@unique([frameworkId, version])
  @@map("app_framework_version")
}

enum FrameworkVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// One record of a version: an entity (an appeal, a move, a thinker) or a
/// singleton section (`meta`, `scoring`). Its attributes are validated by the
/// kind's Zod schema in the framework's definition.
model FrameworkNode {
  id         String           @id @default(cuid())
  versionId  String
  version    FrameworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind       String
  /// The model's own id (`eth_goodwill`), or the section name for a singleton.
  key        String
  /// The containing record's key, for a nested record (a lever's perspective).
  parentKey  String?
  name       String?
  /// Order within its collection, kept so the model round-trips exactly.
  position   Int
  attributes Json
  linksFrom  FrameworkLink[]  @relation("FrameworkLinkFrom")
  linksTo    FrameworkLink[]  @relation("FrameworkLinkTo")

  @@unique([versionId, kind, key])
  @@index([versionId, kind, position])
  @@map("app_framework_node")
}

/// A reference from one record to another (`grounded_in`, `research`, …),
/// written by the import from the reference fields the definition declares.
model FrameworkLink {
  id         String           @id @default(cuid())
  versionId  String
  version    FrameworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   FrameworkNode    @relation("FrameworkLinkFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     FrameworkNode    @relation("FrameworkLinkTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  relation   String

  @@unique([versionId, fromNodeId, toNodeId, relation])
  @@index([toNodeId])
  @@map("app_framework_link")
}

// ─── Assessments (t-22, f-assessments) ───────────────────────────────────────
//
// A text, the assessments run on it, and each judge's run. Design:
// .context/app/planning/app-plan.md §8.2, §9; .context/app/assessments.md.
// All three are tenant-owned (`orgId`, cascade, `org_isolation`): they are the
// workspace's, so a member's erasure clears the user columns and leaves the
// rows. User and API-key columns are plain strings with hand-written FKs in the
// migration, so core's `User` and `AiApiKey` are not edited.

/// A text an assessment judged, as intake produced it. Kept so a run can be
/// re-driven, and purged by the workspace's retention window (t-26).
model Content {
  id              String            @id @default(cuid())
  orgId           String?
  org             Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The project it belongs to (t-70). SET NULL: archiving or erasing a
  /// project never removes the workspace's copy.
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String?
  sourceKind      ContentSourceKind
  sourceUrl       String?
  fileName        String?
  text            String
  textSha256      String
  wordCount       Int
  /// Who added it. FK → user, ON DELETE SET NULL (the workspace keeps it).
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  assessments     Assessment[]

  @@index([orgId, createdAt])
  @@map("app_content")
}

enum ContentSourceKind {
  TEXT
  FILE
  URL
}

/// One assessment of a content row against one framework version: the quick
/// scan, then the judges its profile chose, assembled. Runs as a job under a
/// lease (`lib/app/assessments/run.ts`).
model Assessment {
  id                 String           @id @default(cuid())
  orgId              String?
  org                Org?             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentId          String
  content            Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  /// The project it ran in (t-70), whose defaults it took. SET NULL, as on `Content`.
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  /// The profile asked for (`quick`, `full`, a catalogue group), or `custom`
  /// for an explicit list of judges.
  profile            String
  /// The judge slots the profile resolved to when it was asked for, in order.
  judges             String[]
  /// Who the text is for (the engine's context), as validated at intake.
  context            Json
  /// The project's adjustment to the weights it was scored with (t-72), as
  /// checked against this version. Null for none.
  overlay            Json?
  /// What the AI reviewers were given of its project (t-75,
  /// lib/app/projects/context.ts): `{ brief, documents: [{ id, title }],
  /// passages: [{ documentId, chunkId, text }] }`, written once by the run
  /// before its first judge, and re-read by a re-driven run. Null outside a
  /// project. A project that gave them nothing is stored as an empty record
  /// (`{ brief: null, documents: [], passages: [] }`), so a re-drive does not
  /// search again; the API answers that as `contextUsed: null`.
  projectContext     Json?
  status             AssessmentStatus @default(QUEUED)
  /// The engine's `assemble()` output, once the run is final.
  result             Json?
  overall            Float?
  band               String?
  /// What every judge run cost, summed.
  costUsd            Float            @default(0)
  /// Why the run failed, for `FAILED`. A partial run's reasons are on its judge runs.
  error              String?
  /// What kind of failure, when it has one: `BUDGET_EXCEEDED` for a review
  /// refused as it was claimed (t-53, lib/app/usage/budget.ts). `null` otherwise.
  errorCode          String?
  /// Its figures, for `BUDGET_EXCEEDED`: the refusal's `details`.
  errorDetails       Json?
  /// Runs started on it. The recovery job gives up after three.
  attempts           Int              @default(0)
  leaseToken         String?
  leaseExpiresAt     DateTime?
  requestedVia       AssessmentVia
  /// The API key it came through. FK → ai_api_key, ON DELETE SET NULL.
  apiKeyId           String?
  /// Who asked for it. FK → user, ON DELETE SET NULL.
  createdByUserId    String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  judgeRuns          JudgeRun[]
  shares             ReportShare[]
  rewrites           Rewrite[]

  /// The budget check's history and in-flight reads (t-54, lib/app/usage/budget.ts).
  @@index([orgId, status, createdAt])
  @@index([orgId, profile, status, createdAt])
  /// The retention purge's content-window delete (t-26).
  @@index([orgId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([contentId])
  @@index([projectId, createdAt])
  @@map("app_assessment")
}

/// A place under the workspace's running limit held by a review kept nowhere
/// (`store: false`, t-28), which has no `Assessment` row for the claim to
/// count. Taken in the same serializable count as a stored run's claim
/// (`lib/app/assessments/places.ts`), renewed while the run is alive, and
/// deleted when it ends. One whose lease has run out (its process died) is
/// free, and the next take deletes it. Carries no `userId`: it is a lease, not
/// a record of who asked. Tenant-owned (`orgId`, cascade, `org_isolation`).
model AssessmentPlace {
  id             String   @id @default(cuid())
  orgId          String?
  org            Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())

  @@index([orgId, leaseExpiresAt])
  @@map("app_assessment_place")
}

/// What a review request holds of its workspace's monthly budget from the
/// moment its budget check passes (t-50, t-51, `lib/app/usage/budget.ts`),
/// so requests arriving together cannot each spend the same remainder. A
/// stored request holds it until its `Assessment` row exists, which then
/// counts in its place; a `store: false` request, which has no row, until its
/// run ends. Renewed while held, and deleted when released. One whose lease
/// has run out (its process died) holds nothing, and the next check deletes
/// it. Carries no `userId`: it is a lease, not a record of who asked.
/// Tenant-owned (`orgId`, cascade, `org_isolation`).
model BudgetHold {
  id             String   @id @default(cuid())
  orgId          String?
  org            Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The judges the request calls: held at each checker's own rate.
  judges         Int
  /// A stored review, which the editor runs on once it calls enough judges.
  stored         Boolean
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())

  @@index([orgId, leaseExpiresAt])
  @@map("app_budget_hold")
}

enum AssessmentStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AssessmentVia {
  APP
  API
}

/// One judge's run within an assessment, saved as it lands. A failed judge's
/// dimensions fall back to the quick scan, and its row says why.
model JudgeRun {
  id           String         @id @default(cuid())
  orgId        String?
  org          Org?           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  judge        String
  status       JudgeRunStatus
  provider     String?
  modelName    String?
  /// Provider attempts billed (the runner's one retry makes two).
  attempts     Int            @default(0)
  costUsd      Float          @default(0)
  /// `{ input, output }` tokens across the attempts.
  tokens       Json?
  latencyMs    Int?
  /// The judge's reply, for `SUCCEEDED`, until retention deletes it (t-26).
  reply        JudgeReply?
  /// For `FAILED`: the `JudgeRunError` code, and its message.
  errorCode    String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, judge])
  /// Leads with `orgId`, so it serves every org-scoped read; and the budget
  /// check's recent succeeded runs (t-54, lib/app/usage/budget.ts).
  @@index([orgId, status, createdAt])
  @@map("app_judge_run")
}

enum JudgeRunStatus {
  SUCCEEDED
  FAILED
}

/// A succeeded judge run's reply, kept apart from the run because it lives
/// less long (D10, t-26): it quotes the text, and the retention purge deletes
/// it after the workspace's reply window (30 days unless set). The run keeps
/// its model, cost, tokens and timing for as long as the assessment lasts,
/// and the assessment's assembled `result` is what is read once it is final.
model JudgeReply {
  id         String   @id @default(cuid())
  orgId      String?
  org        Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  judgeRunId String   @unique
  judgeRun   JudgeRun @relation(fields: [judgeRunId], references: [id], onDelete: Cascade)
  /// The engine's post-validated reply, which `assemble()` reads.
  output     Json
  /// What post-validation dropped or changed in the reply.
  dropped    Json
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("app_judge_reply")
}

// ─── Share links (t-32, f-sharing) ───────────────────────────────────────────

/// A link that opens one report, read-only, for someone without an account
/// (`/r/{token}`). Design: .context/app/report.md (Share links). The token is
/// 32 random bytes; only its SHA-256 is stored, so the link is shown once, when
/// it is made. Tenant-owned (`orgId`, cascade, `org_isolation`); the FK to the
/// assessment cascades, so a delete or the retention purge takes its links.
model ReportShare {
  id              String     @id @default(cuid())
  orgId           String?
  org             Org?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token, hex. The token itself is never stored.
  tokenHash       String     @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  /// Times the link was opened, page or API.
  viewCount       Int        @default(0)
  /// Who made it. FK → user, ON DELETE SET NULL (the workspace keeps the link).
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assessmentId, createdAt])
  @@index([orgId])
  @@map("app_report_share")
}

// ─── Calibration (t-37, f-calibration) ───────────────────────────────────────

/// One run of the calibration set against a framework version: every case
/// through the quick scan (`QUICK`) or the judges (`AI`), each expectation
/// scored. Design: .context/app/calibration.md. Publishing a draft needs an
/// `AI` run of it (`publishVersion`). Owned by the install org (`orgId`,
/// cascade, `org_isolation`), written in the system scope by
/// lib/app/calibration/store.ts. Keeps no Assessment rows.
model CalibrationRun {
  id                 String               @id @default(cuid())
  orgId              String?
  org                Org?                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion     @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  /// The version's `sourceSha256` when it ran: a draft re-imported since is
  /// different content, and the run no longer counts for it.
  sourceSha256       String
  /// The calibration set's `meta.version`.
  setVersion         String
  mode               CalibrationMode
  /// `RUNNING` from the moment it starts (t-38: a run started from the admin
  /// page finishes in the background, and the page shows it running), then
  /// `COMPLETE` with its results, or `FAILED` with `error`. Only a
  /// `COMPLETE` run is compared with or lets a draft publish.
  status             CalibrationRunStatus
  /// The provider and model each judge answered with, by slot. `{}` for `QUICK`.
  judgeModels        Json
  /// Agreement by kind of expectation (`lib/app/calibration/score.ts`). Null until `COMPLETE`.
  totals             Json?
  /// Each case's scored expectations. Null until `COMPLETE`.
  rows               Json?
  /// Why a `FAILED` run stopped.
  error              String?
  finishedAt         DateTime?
  /// Touched every `HEARTBEAT_MS` while the run is alive
  /// (`lib/app/calibration/store.ts`). A `RUNNING` run whose beat is older
  /// than `STOPPED_AFTER_MS` is stopped: the process running it went away.
  heartbeatAt        DateTime             @default(now())
  /// What the judge calls cost, summed from each reply's and each billed
  /// failure's cost (the same figures runJudge wrote to `AiCostLog`).
  costUsd            Float                @default(0)
  /// Who started it. FK → user, ON DELETE SET NULL. Null from the CLI.
  startedByUserId    String?
  createdAt          DateTime             @default(now())

  @@index([frameworkVersionId, mode, createdAt])
  @@index([frameworkVersionId, mode, status])
  @@index([mode, createdAt])
  @@index([orgId])
  @@map("app_calibration_run")
}

enum CalibrationMode {
  QUICK
  AI
}

enum CalibrationRunStatus {
  RUNNING
  COMPLETE
  FAILED
}

// ─── CopyCredits (t-57, f-credits) ───────────────────────────────────────────

/// One change to a workspace's CopyCredits balance: credits an admin granted
/// or adjusted, a code redeemed (t-60), or a review charged (t-58). Design:
/// .context/app/credits.md. Append-only: the balance is the sum of `amount`,
/// and nothing updates or deletes a row except the workspace's own erasure.
/// Tenant-owned (`orgId`, cascade, `org_isolation`).
model CreditEntry {
  id          String          @id @default(cuid())
  orgId       String?
  org         Org?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Credits, signed: positive adds to the balance, negative takes from it.
  amount      Int
  kind        CreditEntryKind
  /// Why, in words: required for an admin's grant or adjustment.
  reason      String?
  /// Who made the change: the admin, or whoever redeemed. Null for a charge,
  /// or once that user is erased. FK → user, ON DELETE SET NULL (the
  /// workspace keeps its ledger).
  actorUserId String?
  /// What the change is for, as `<kind>:<id>` (a redemption, a review), so one
  /// thing is credited or charged once. Null for an admin's change.
  reference   String?
  createdAt   DateTime        @default(now())

  @@unique([kind, reference])
  @@index([orgId, createdAt])
  @@map("app_credit_entry")
}

enum CreditEntryKind {
  /// An admin gave credits.
  GRANT
  /// An admin corrected the balance, up or down.
  ADJUST
  /// A free review code was redeemed (t-60).
  REDEEM
  /// A review was charged for what it spent (t-58).
  CHARGE
}

// ─── Free review codes (t-59, f-credits) ─────────────────────────────────────

/// A free review code: someone who redeems it gets `creditsPerRedemption`
/// CopyCredits for their workspace (t-60), up to `maxRedemptions` times (1 for
/// a personal code, N for a QR card). Its redemptions are counted from
/// `ReviewCodeRedemption`, never stored on the code. Design: .context/app/credits.md.
/// Install-level shared config (`globalConfig`): no `orgId`, made by platform
/// admins, redeemed into whichever workspace redeems it.
model ReviewCode {
  id                   String                 @id @default(cuid())
  /// The code itself, canonical: upper case, no separators, from the
  /// unambiguous alphabet in `lib/app/credits/codes/generate.ts`. Stored, not
  /// hashed, so the admin page can show its link and QR again (t-59 decision).
  code                 String                 @unique
  creditsPerRedemption Int
  maxRedemptions       Int
  expiresAt            DateTime
  /// Which campaign, card run or representative it was made for.
  campaign             String
  /// Who made it. FK → user, ON DELETE SET NULL (the code outlives its maker).
  createdByUserId      String?
  revokedAt            DateTime?
  /// The issuing call's idempotency key, and the code's place in its batch,
  /// so a retried call mints its codes once. Null for a call without a key.
  idempotencyKey       String?
  batchIndex           Int                    @default(0)
  createdAt            DateTime               @default(now())
  /// How many times it has been redeemed is how many of these there are
  /// (t-60): the code row itself is config, and redeeming never writes it.
  redemptions          ReviewCodeRedemption[]

  @@unique([idempotencyKey, batchIndex])
  @@index([createdAt])
  @@map("app_review_code")
}

/// One redemption of a free review code (t-60): who redeemed it, into which
/// workspace, for how many credits. The workspace's `REDEEM` credit entry
/// references it as `redemption:<id>`. Design: .context/app/credits.md.
///
/// **The count of a code's redemptions is the count of these rows**, so the
/// shared code row is never written by a customer. Each takes a `slot`, its
/// place among the code's uses from 0, which is unique per code and below the
/// code's `maxRedemptions` when written: distinct slots each below the
/// maximum cannot number more than the maximum, however many redeem at once.
///
/// **Rows are never deleted**, so slots stay dense and a code's uses never
/// come back: the workspace and the person are SET NULL on erasure, leaving
/// the code, the slot, the credits and the time. A workspace erased after
/// redeeming a personal code does not make that code redeemable again.
model ReviewCodeRedemption {
  id        String     @id @default(cuid())
  codeId    String
  /// RESTRICT: a code with redemptions is history, and nothing deletes codes.
  code      ReviewCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  /// Its place among the code's uses, from 0.
  slot      Int
  /// SET NULL, not CASCADE: the use outlives the workspace's erasure.
  orgId     String?
  org       Org?       @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// Who redeemed it. FK → user, ON DELETE SET NULL (hand-written, B11).
  userId    String?
  /// What it gave, as the code granted then.
  credits   Int
  createdAt DateTime   @default(now())

  @@unique([codeId, slot])
  /// One per person per code. Postgres treats NULLs as distinct, so an
  /// erased person's row does not count against anyone.
  @@unique([codeId, userId])
  @@index([orgId, createdAt])
  @@map("app_review_code_redemption")
}

/// A workspace's project (t-70, f-projects): one client, product or campaign,
/// holding the brief the AI reviewers read and the defaults a review in it
/// takes (type of copy, audience, culture, profile). Any member may read and
/// change one; it is the workspace's, not its maker's.
///
/// `defaults` is stored as the caller gave it, so what it leaves out stays
/// left out and the version's own defaults still apply. It is checked against
/// the framework's latest published version when written, and again, with the
/// request's own fields over it, against the version a review runs with.
///
/// Archived rather than deleted (`archivedAt`), so its reviews keep their
/// link. `createdByUserId` has a hand-written FK to "user" (SET NULL).
/// Tenant-owned (`orgId`, cascade, `org_isolation`).
model Project {
  id              String            @id @default(cuid())
  orgId           String?
  org             Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  /// What the copy is for, in the author's words: `{ offer, audience, voice, markets, goals }`.
  brief           Json
  /// `{ context?, profile? }`, as given (lib/app/projects/validations.ts).
  defaults        Json
  /// Its adjustment to the framework's weights (D5, t-72):
  /// `{ weights?, priorityDimensions? }`, checked against the bounds the
  /// version declares (lib/app/projects/overlay.ts). `{}` for none, which the
  /// API answers as null: SQL NULL would need `Prisma.DbNull`, a runtime
  /// Prisma import `lib/app/**` may not make (as `writeAppSettings`).
  overlay         Json              @default("{}")
  frameworkId     String
  framework       Framework         @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  archivedAt      DateTime?
  /// Who made it. FK → user, ON DELETE SET NULL (the workspace keeps it).
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contents        Content[]
  assessments     Assessment[]
  documents       ProjectDocument[]

  @@index([orgId, archivedAt, createdAt])
  @@map("app_project")
}

/// A context document linked to a project (t-74, D18, app-plan §8.4): a
/// positioning paper, a brand guide, last year's campaign. Its text lives in
/// the workspace's knowledge base (core's `AiKnowledgeDocument`), put there by
/// `uploadDocument`, which chunks and embeds it; this row links it to the
/// project. Its status is the knowledge row's, read live.
///
/// `uploadDocument` deduplicates by content hash across the workspace, so one
/// knowledge row can back several projects' links, or one first uploaded
/// through core's knowledge page. Removing a link deletes the knowledge row
/// only when an upload by this app created it (`createdByUpload` on some link
/// to it), no other link remains, no agent is granted it, it carries no tag,
/// and it is not still being embedded (lib/app/projects/documents.ts).
///
/// `knowledgeDocumentId` and `addedByUserId` are plain strings with
/// hand-written FKs in the migration, so core's schema is not edited (§9).
model ProjectDocument {
  id                  String   @id @default(cuid())
  orgId               String?
  org                 Org?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// FK → ai_knowledge_document, ON DELETE CASCADE: a document deleted
  /// through core's knowledge page takes its links with it.
  knowledgeDocumentId String
  /// The name the project shows it by: given when added, else the document's own title.
  title               String
  /// The file it was read from, or null for a page.
  fileName            String?
  /// The page it was fetched from, after redirects, or null for a file.
  sourceUrl           String?
  /// Whether an upload by this app made the knowledge row, rather than
  /// reusing one by content hash. Kept on some link while any remains: a
  /// removed link that holds it hands it to another (documents.ts).
  createdByUpload     Boolean  @default(false)
  /// Who added it. FK → user, ON DELETE SET NULL (the workspace keeps it).
  addedByUserId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([projectId, knowledgeDocumentId])
  @@index([knowledgeDocumentId])
  @@index([orgId])
  @@map("app_project_document")
}

// ─── Rewrites (t-81, f-rewrite) ──────────────────────────────────────────────

/// A draft the editor rewrote from a finished review (app-plan §8.2,
/// .context/app/rewrites.md): streamed while it runs, then kept. Tenant-owned
/// (`orgId`, cascade, `org_isolation`). The FK to its assessment cascades, so
/// deleting or purging a review (t-26) takes its rewrites. `createdByUserId`
/// is a plain string with a hand-written FK to "user" in the migration, SET
/// NULL: the rewrite is the workspace's and outlives its maker's erasure.
model Rewrite {
  id              String        @id @default(cuid())
  orgId           String?
  org             Org?          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// `balanced`, or the appeal the rewrite raises (the engine's `rewriteFocuses()`).
  focus           String
  status          RewriteStatus @default(RUNNING)
  /// The draft as written so far while `RUNNING` (saved as it streams), then whole.
  draft           String        @default("")
  /// What the budget check holds back for it while `RUNNING`, in USD
  /// (lib/app/usage/budget.ts): its estimate when it was asked for.
  heldUsd         Float         @default(0)
  provider        String?
  modelName       String?
  /// What its call cost, from its cost rows (tagged `rewriteId`).
  costUsd         Float         @default(0)
  /// Why it failed, for `FAILED`.
  error           String?
  errorCode       String?
  /// Renewed while its call runs. A `RUNNING` rewrite whose lease has run
  /// out lost its process: the recovery job fails and charges it.
  leaseExpiresAt  DateTime?
  /// Who asked for it. FK → user, ON DELETE SET NULL (the workspace keeps it).
  createdByUserId String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([assessmentId, createdAt])
  /// The budget check's in-flight and history reads, and recovery's sweep.
  @@index([orgId, status, createdAt])
  @@map("app_rewrite")
}

enum RewriteStatus {
  RUNNING
  COMPLETED
  FAILED
}
