// Fork-owned schema file — reserved for YOUR app's models.
//
// Sunrise ships this file empty and never adds models to it, the same way it
// keeps `lib/app/**` and `.context/app/` empty, so a fork's models here merge
// cleanly on every upstream sync. Sunrise's own app-domain models
// (ContactSubmission, FeatureFlag, AuthBootstrap) live in `platform.prisma`.
//
// The schema is multi-file (`prisma.config.ts` → `schema: 'prisma/schema'`), so
// every `.prisma` file in this folder is loaded — just add models below.
//
// See CUSTOMIZATION.md §5 for the FK/onDelete rules a model with a `userId`
// must follow (GDPR erasure depends on them).

/// An invitation into a workspace for someone who already has an account
/// (t-9). The invitee sees it in the app and accepts or declines it; accepting
/// adds them through core's `addMember()`. A person with no account is invited
/// by core's sign-up invitation instead, from the same form.
///
/// One row per person per workspace: re-inviting someone who declined, let it
/// expire, or left resets the row to PENDING, so no partial unique index is
/// needed (B13). `userId` and `invitedByUserId` are plain strings with
/// hand-written FKs in the migration, so `User` (core) is not edited.
model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  orgId           String?
  org             Org?                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The invitee. FK → user, ON DELETE CASCADE (an invitation is theirs).
  userId          String
  role            OrgRole                   @default(MEMBER)
  status          WorkspaceInvitationStatus @default(PENDING)
  /// Who sent it. FK → user, ON DELETE SET NULL (the workspace keeps the record).
  invitedByUserId String?
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([orgId, userId])
  @@index([userId, status])
  @@index([orgId])
  @@map("app_workspace_invitation")
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Frameworks (t-10, f-framework-store) ────────────────────────────────────
//
// A framework's records, versioned. Design: .context/app/planning/app-plan.md
// §8.1. All four are shared config (no orgId; `globalConfig` in
// lib/app/tenancy-classification.ts), written only by lib/app/frameworks/store
// through the import and publish scripts. A published version never changes:
// the store refuses every write that would touch one.

/// A framework the service can judge against (D2), e.g. `howdoesthisland`.
model Framework {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String
  summary   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  versions  FrameworkVersion[]

  @@map("app_framework")
}

/// One version of a framework, imported from a reviewed JSON file.
model FrameworkVersion {
  id             String                 @id @default(cuid())
  frameworkId    String
  framework      Framework              @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  /// Semver, from the file's `meta.version`.
  version        String
  /// The file's own schema version (`meta.schema_version`).
  schemaVersion  String
  status         FrameworkVersionStatus @default(DRAFT)
  /// The imported file as parsed, kept for export and audit.
  sourceDocument Json
  /// sha256 of the imported file's bytes.
  sourceSha256   String
  publishedAt    DateTime?
  /// The calibration run that allowed publishing, copied at publish
  /// (f-calibration). Null until that gate exists.
  calibration    Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  nodes          FrameworkNode[]
  links          FrameworkLink[]
  assessments    Assessment[]

  @@unique([frameworkId, version])
  @@map("app_framework_version")
}

enum FrameworkVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// One record of a version: an entity (an appeal, a move, a thinker) or a
/// singleton section (`meta`, `scoring`). Its attributes are validated by the
/// kind's Zod schema in the framework's definition.
model FrameworkNode {
  id         String           @id @default(cuid())
  versionId  String
  version    FrameworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind       String
  /// The model's own id (`eth_goodwill`), or the section name for a singleton.
  key        String
  /// The containing record's key, for a nested record (a lever's perspective).
  parentKey  String?
  name       String?
  /// Order within its collection, kept so the model round-trips exactly.
  position   Int
  attributes Json
  linksFrom  FrameworkLink[]  @relation("FrameworkLinkFrom")
  linksTo    FrameworkLink[]  @relation("FrameworkLinkTo")

  @@unique([versionId, kind, key])
  @@index([versionId, kind, position])
  @@map("app_framework_node")
}

/// A reference from one record to another (`grounded_in`, `research`, …),
/// written by the import from the reference fields the definition declares.
model FrameworkLink {
  id         String           @id @default(cuid())
  versionId  String
  version    FrameworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   FrameworkNode    @relation("FrameworkLinkFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     FrameworkNode    @relation("FrameworkLinkTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  relation   String

  @@unique([versionId, fromNodeId, toNodeId, relation])
  @@index([toNodeId])
  @@map("app_framework_link")
}

// ─── Assessments (t-22, f-assessments) ───────────────────────────────────────
//
// A text, the assessments run on it, and each judge's run. Design:
// .context/app/planning/app-plan.md §8.2, §9; .context/app/assessments.md.
// All three are tenant-owned (`orgId`, cascade, `org_isolation`): they are the
// workspace's, so a member's erasure clears the user columns and leaves the
// rows. User and API-key columns are plain strings with hand-written FKs in the
// migration, so core's `User` and `AiApiKey` are not edited.

/// A text an assessment judged, as intake produced it. Kept so a run can be
/// re-driven, and purged by the workspace's retention window (t-26).
model Content {
  id              String            @id @default(cuid())
  orgId           String?
  org             Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The project it belongs to (f-projects). No FK until that model exists.
  projectId       String?
  title           String?
  sourceKind      ContentSourceKind
  sourceUrl       String?
  fileName        String?
  text            String
  textSha256      String
  wordCount       Int
  /// Who added it. FK → user, ON DELETE SET NULL (the workspace keeps it).
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  assessments     Assessment[]

  @@index([orgId, createdAt])
  @@map("app_content")
}

enum ContentSourceKind {
  TEXT
  FILE
  URL
}

/// One assessment of a content row against one framework version: the quick
/// scan, then the judges its profile chose, assembled. Runs as a job under a
/// lease (`lib/app/assessments/run.ts`).
model Assessment {
  id                 String           @id @default(cuid())
  orgId              String?
  org                Org?             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contentId          String
  content            Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  projectId          String?
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  /// The profile asked for (`quick`, `full`, a catalogue group), or `custom`
  /// for an explicit list of judges.
  profile            String
  /// The judge slots the profile resolved to when it was asked for, in order.
  judges             String[]
  /// Who the text is for (the engine's context), as validated at intake.
  context            Json
  status             AssessmentStatus @default(QUEUED)
  /// The engine's `assemble()` output, once the run is final.
  result             Json?
  overall            Float?
  band               String?
  /// What every judge run cost, summed.
  costUsd            Float            @default(0)
  /// Why the run failed, for `FAILED`. A partial run's reasons are on its judge runs.
  error              String?
  /// Runs started on it. The recovery job gives up after three.
  attempts           Int              @default(0)
  leaseToken         String?
  leaseExpiresAt     DateTime?
  requestedVia       AssessmentVia
  /// The API key it came through. FK → ai_api_key, ON DELETE SET NULL.
  apiKeyId           String?
  /// Who asked for it. FK → user, ON DELETE SET NULL.
  createdByUserId    String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  judgeRuns          JudgeRun[]

  @@index([orgId, status])
  @@index([status, leaseExpiresAt])
  @@index([contentId])
  @@map("app_assessment")
}

enum AssessmentStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AssessmentVia {
  APP
  API
}

/// One judge's run within an assessment, saved as it lands. A failed judge's
/// dimensions fall back to the quick scan, and its row says why.
model JudgeRun {
  id           String         @id @default(cuid())
  orgId        String?
  org          Org?           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  judge        String
  status       JudgeRunStatus
  provider     String?
  modelName    String?
  /// Provider attempts billed (the runner's one retry makes two).
  attempts     Int            @default(0)
  costUsd      Float          @default(0)
  /// `{ input, output }` tokens across the attempts.
  tokens       Json?
  latencyMs    Int?
  /// The engine's post-validated reply, which `assemble()` reads.
  output       Json?
  /// What post-validation dropped or changed in the reply.
  dropped      Json?
  /// For `FAILED`: the `JudgeRunError` code, and its message.
  errorCode    String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, judge])
  @@index([orgId])
  @@map("app_judge_run")
}

enum JudgeRunStatus {
  SUCCEEDED
  FAILED
}
